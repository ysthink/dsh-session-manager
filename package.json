{
  "name": "@local/session-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Browse, search and permanently delete stored sessions, individually or per workspace.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysthink/dsh-session-manager.git"
  },
  "homepage": "https://github.com/ysthink/dsh-session-manager#readme",
  "bugs": {
    "url": "https://github.com/ysthink/dsh-session-manager/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session-management",
    "recycle-bin"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
